{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fernsicht",
  "version": "0.1.0",
  "identifier": "dev.fernsicht.app",
  "build": {
    "frontendDist": "../client-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @fernsicht/client-ui dev",
    "beforeBuildCommand": "pnpm --filter @fernsicht/client-ui build && pnpm --filter @fernsicht/viewer build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fernsicht",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Remote-Desktop und Game-Streaming im LAN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/fernsicht-client",
      "binaries/fernsicht-host-agent"
    ],
    "resources": {
      "../../web/viewer/dist/": "viewer/"
    },
    "longDescription": "Fernsicht streamt den Bildschirm eines Rechners mit sehr wenig Verzögerung zu anderen Geräten im Netz: Desktop und Spiele, mit Maus, Tastatur, Controller und Ton. Dieselbe App verbindet sich mit anderen Rechnern und gibt diesen Rechner frei."
  }
}
