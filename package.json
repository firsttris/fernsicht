{
  "name": "fernsicht",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:client": "pnpm --filter @fernsicht/client-ui dev",
    "dev:viewer": "pnpm --filter @fernsicht/viewer dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"apps/client-ui/**/*.{ts,tsx,css}\" \"web/**/*.{ts,tsx,css}\" \"*.ts\"",
    "format:check": "prettier --check \"apps/client-ui/**/*.{ts,tsx,css}\" \"web/**/*.{ts,tsx,css}\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @fernsicht/web-e2e test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
