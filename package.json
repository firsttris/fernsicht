{
  "name": "fernsicht",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web/*"
  ],
  "scripts": {
    "dev:client": "bun run --filter @fernsicht/client-ui dev",
    "dev:viewer": "bun run --filter @fernsicht/viewer dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check",
    "lint": "biome lint",
    "format": "biome format --write",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:e2e": "bun run --filter @fernsicht/web-e2e test",
    "screenshots": "bash scripts/screenshots.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
